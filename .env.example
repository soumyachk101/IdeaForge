# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder-v2
ANTHROPIC_API_KEY=

# Reddit API (get from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=IdeaForge/0.1.0

# Product Hunt API (get from https://www.producthunt.com/v2/oauth/applications)
PRODUCT_HUNT_TOKEN=

# RAG Configuration
CHROMA_PATH=./.ideaforge_data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Server
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:3000
